{
  "headers": [
    {
      "source": "/video_frames_24fps/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.brizpatel.online"
        }
      ],
      "destination": "https://brizpatel.online/$1",
      "permanent": true
    }
  ]
}